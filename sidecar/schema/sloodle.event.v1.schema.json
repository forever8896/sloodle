{
  "title": "sloodle.event.v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "courseId": {
          "type": "string"
        },
        "source": {
          "default": "live",
          "type": "string",
          "enum": [
            "live",
            "migration"
          ]
        },
        "type": {
          "type": "string",
          "const": "answer"
        },
        "sessionId": {
          "type": "string"
        },
        "questionId": {
          "type": "string"
        },
        "objectiveId": {
          "type": "string"
        },
        "checkId": {
          "description": "Set when the question came from the course's lesson plan.",
          "type": "string"
        },
        "blockId": {
          "description": "Set when the work was a component from the course's lesson plan.",
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "choice",
            "short",
            "explain",
            "numeric",
            "ordering",
            "matching",
            "blanks",
            "prediction",
            "flashcard"
          ]
        },
        "component": {
          "description": "The lesson component the answer was given in; absent for questions.",
          "type": "string",
          "enum": [
            "markdown",
            "diagram",
            "code",
            "ordering",
            "matching",
            "blanks",
            "steps",
            "flashcard",
            "table",
            "callout",
            "image"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hintsUsed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hintsAvailable": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "confidence": {
          "description": "1 guessing, 2 fairly sure, 3 certain.",
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "secondsToAnswer": {
          "type": "number",
          "minimum": 0
        },
        "presented": {
          "default": [],
          "description": "Intents of material shown since the previous answer.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "activate",
              "explain",
              "example",
              "analogy",
              "visual",
              "practice",
              "recall",
              "reflect",
              "project",
              "summary"
            ]
          }
        },
        "misconceptions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ]
          }
        }
      },
      "required": [
        "id",
        "at",
        "courseId",
        "type",
        "sessionId",
        "questionId",
        "kind",
        "score",
        "hintsUsed"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "courseId": {
          "type": "string"
        },
        "source": {
          "default": "live",
          "type": "string",
          "enum": [
            "live",
            "migration"
          ]
        },
        "type": {
          "type": "string",
          "const": "hint"
        },
        "sessionId": {
          "type": "string"
        },
        "questionId": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "at",
        "courseId",
        "type",
        "sessionId",
        "questionId",
        "index"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "courseId": {
          "type": "string"
        },
        "source": {
          "default": "live",
          "type": "string",
          "enum": [
            "live",
            "migration"
          ]
        },
        "type": {
          "type": "string",
          "const": "review"
        },
        "itemId": {
          "type": "string"
        },
        "objectiveId": {
          "type": "string"
        },
        "grade": {
          "type": "string",
          "enum": [
            "again",
            "hard",
            "good",
            "easy"
          ]
        }
      },
      "required": [
        "id",
        "at",
        "courseId",
        "type",
        "itemId",
        "grade"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "courseId": {
          "type": "string"
        },
        "source": {
          "default": "live",
          "type": "string",
          "enum": [
            "live",
            "migration"
          ]
        },
        "type": {
          "type": "string",
          "const": "session_end"
        },
        "sessionId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "interview",
            "planning",
            "lesson"
          ]
        },
        "startedAt": {
          "type": "string"
        },
        "minutes": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "at",
        "courseId",
        "type",
        "sessionId",
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "courseId": {
          "type": "string"
        },
        "source": {
          "default": "live",
          "type": "string",
          "enum": [
            "live",
            "migration"
          ]
        },
        "type": {
          "type": "string",
          "const": "course_revised"
        },
        "proposalId": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "description": "What changed, in plain words."
        },
        "backup": {
          "type": "string",
          "description": "Where the previous course.json was saved, relative to the data folder."
        },
        "added": {
          "default": [],
          "description": "Objective ids added.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "default": [],
          "description": "Objective ids removed. Their progress is kept in progress.json.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "default": [],
          "description": "Objective ids edited, moved or re-planned.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "at",
        "courseId",
        "type",
        "proposalId",
        "summary",
        "backup"
      ]
    }
  ]
}
